# Server
PORT=3000

# Currency (single source of truth — Stripe uses this directly, and the
# frontend fetches it via GET /api/config to derive its display symbol,
# so there is no separate currency value to keep in sync anywhere else)
CURRENCY=usd

# MongoDB Atlas — connection string only, no trailing slash
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Clerk (Auth)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Cloudinary (room images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (payments)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo SMTP (confirmation emails)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# Frontend origin (used in CORS + Stripe redirect URLs) — set for local dev
CLIENT_URL=http://localhost:5173
